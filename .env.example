SERVER_PORT=8090
DB_URL=jdbc:postgresql://localhost:5432/quistock
DB_USERNAME=auth_readonly
DB_PASSWORD=replace-locally
MONGODB_URI=mongodb://localhost:27017/?replicaSet=rs0
MONGODB_DATABASE=quistock_auth
AUTH_JWT_ISSUER=http://localhost:8090
AUTH_JWT_AUDIENCE=quistock-api
AUTH_JWT_PRIVATE_KEY_PATH=./dev-keys/private-key.pem
AUTH_JWT_PUBLIC_KEY_PATH=./dev-keys/public-key.pem
AUTH_JWT_PREVIOUS_PUBLIC_KEYS=
AUTH_JWT_KEY_ID=local-dev
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_COOKIE_PATH=/
AUTH_COOKIE_DOMAIN=
AUTH_BCRYPT_STRENGTH=12
AUTH_RATE_LIMIT_HMAC_KEY=
AUTH_TRUSTED_PROXY_CIDRS=

# Optional migration override; empty means root
SERVER_SERVLET_CONTEXT_PATH=

HEALTH_TIMEOUT_MS=4000
